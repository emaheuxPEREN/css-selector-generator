{
  "include": ["**/*.ts"],
  "compilerOptions": {
    "allowJs": true,
    "declaration": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "target": "es2022"
  }
}
